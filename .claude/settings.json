{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "low",
    "OPENROUTER_REASONING_EFFORT": "low",
    "OPENROUTER_CONTEXT_MODEL": "x-ai/grok-4.1-fast",
    "OPENROUTER_PLANNING_MODEL": "deepseek/deepseek-v4-pro",
    "OPENROUTER_EXECUTION_MODEL": "deepseek/deepseek-v4-flash",
    "OPENROUTER_VISION_MODEL": "google/gemini-2.5-pro"
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "Bash(git init)",
      "Bash(git add -A)",
      "Bash(Get-ChildItem -Force)",
      "Bash(Get-ChildItem -Recurse -File -Include *.md *)",
      "PowerShell(Get-ChildItem -Force)",
      "PowerShell(Get-ChildItem -Recurse -File -Include *.md *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cp \"$CLAUDE_TOOL_INPUT_FILE\" \"$CLAUDE_TOOL_INPUT_FILE.bak\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"$CLAUDE_TOOL_OUTPUT_FILE\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$(date): $CLAUDE_TOOL_NAME on $CLAUDE_TOOL_OUTPUT_FILE\" >> ~/.claude/activity.log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -Command \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\chimes.wav').PlaySync()\""
          },
          {
            "type": "command",
            "command": "powershell.exe -Command \"Add-Type -AssemblyName System.Windows.Forms; $n = New-Object System.Windows.Forms.NotifyIcon; $n.Icon = [System.Drawing.SystemIcons]::Information; $n.BalloonTipTitle = 'Claude Code'; $n.BalloonTipText = 'Claude Code cần bạn'; $n.Visible = $true; $n.ShowBalloonTip(5000)\""
          }
        ]
      }
    ]
  }
}
